super + Return
	kitty

super + space
	rofi -show drun

super + shift + q
	bspc node -c

super + alt + q
	bspc quit

super + shift + r
	pkill -USR1 -x sxhkd

super + {_,shift + }{1-5}
	bspc {desktop -f,node -d} '^{1-5}'

super + {h,j,k,l}
	bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

super + ctrl + h
	bspc node -z left -20 0 || bspc node -z right -20 0

super + ctrl + l
	bspc node -z right 20 0 || bspc node -z left 20 0

super + ctrl + j
	bspc node -z bottom 0 20 || bspc node -z top 0 20

super + ctrl + k
	bspc node -z top 0 -20 || bspc node -z bottom 0 -20

super + f
	bspc node -t ~fullscreen

super + shift + space
	bspc node -t ~floating

ctrl + space
	rofi -show drun

ctrl + w
	/usr/local/bin/whitehatso-close

super + shift + l
	/usr/local/bin/whitehatso-lock

print
	flameshot gui

super + w
	/usr/local/bin/whitehatso-close
